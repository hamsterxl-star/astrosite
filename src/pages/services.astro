---
// Страница услуг (адрес «/services»). Тарифы и проверки лежат в src/data/services.ts.
import Layout from '../layouts/Layout.astro';
import PlanCard from '../components/PlanCard.astro';
import AuditCard from '../components/AuditCard.astro';
import { plans, audits } from '../data/services';
---
<Layout title="Услуги и цены" description="Тарифы SEO-продвижения сайтов: Базовый, Оптимальный и Расширенный.">
  <h1>Услуги и цены</h1>
  <p class="lead">SEO-продвижение по фиксированным тарифам. Выберите подходящий или напишите, и я помогу определиться.</p>
  <div class="grid list">
    {plans.map((p) => <PlanCard {...p} />)}
  </div>

  <h2>Что ещё проверяю</h2>
  <div class="grid">
    {audits.map((a) => <AuditCard {...a} />)}
  </div>
</Layout>

<style>
  .list { margin-top: 32px; }
</style>
