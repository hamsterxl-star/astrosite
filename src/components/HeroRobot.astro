---
// Робот на первом экране — символ AI-технологий в продвижении.
// Нарисован линиями в стиле фона: мигает глазами, машет рукой,
// на антенне пульсирует огонёк, а сам он медленно парит.
---
<svg class="robot" viewBox="0 0 260 330" aria-hidden="true">
  <g class="robot-body">
    <!-- Антенна -->
    <line x1="130" y1="40" x2="130" y2="20" />
    <circle class="signal" cx="130" cy="14" r="6" />

    <!-- Голова и экран-лицо -->
    <rect class="fill" x="58" y="72" width="12" height="26" rx="4" />
    <rect class="fill" x="190" y="72" width="12" height="26" rx="4" />
    <rect class="fill" x="70" y="40" width="120" height="90" rx="26" />
    <rect class="screen" x="86" y="58" width="88" height="54" rx="16" />
    <g class="eyes">
      <circle class="eye" cx="113" cy="82" r="7" />
      <circle class="eye" cx="147" cy="82" r="7" />
    </g>
    <path d="M118 98 Q130 106 142 98" />

    <!-- Шея и корпус -->
    <rect class="fill" x="118" y="130" width="24" height="12" rx="3" />
    <rect class="fill" x="80" y="142" width="100" height="100" rx="22" />

    <!-- Панель на груди: график роста и надпись AI -->
    <rect class="screen" x="98" y="160" width="64" height="42" rx="8" />
    <polyline class="chart" points="105,192 117,183 128,188 142,172 155,166" />
    <text x="130" y="228">AI</text>

    <!-- Левая рука опущена -->
    <path class="arm" d="M80 162 Q58 182 54 210" />
    <circle class="fill" cx="53" cy="219" r="9" />

    <!-- Правая рука машет -->
    <g class="wave">
      <path class="arm" d="M180 162 Q206 146 216 112" />
      <circle class="fill" cx="218" cy="102" r="9" />
    </g>

    <!-- Ноги -->
    <rect class="fill" x="100" y="242" width="18" height="38" rx="8" />
    <rect class="fill" x="142" y="242" width="18" height="38" rx="8" />
    <rect class="fill" x="92" y="276" width="32" height="12" rx="6" />
    <rect class="fill" x="136" y="276" width="32" height="12" rx="6" />
  </g>
  <!-- Тень под роботом -->
  <ellipse class="shadow" cx="130" cy="316" rx="56" ry="6" />
</svg>

<style>
  .robot {
    position: absolute;
    top: 50%;
    right: max(2%, calc(50% - 524px));
    height: min(330px, 86%);
    width: auto;
    transform: translateY(-50%);
    overflow: visible;
  }
  .robot * {
    fill: none; stroke: var(--hero-icon); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
  }
  .robot .fill { fill: var(--hero-bg); }
  .robot .screen { fill: var(--facet-2); }
  .robot .eye, .robot .signal { fill: var(--hero-icon); stroke: none; }
  .robot .chart { stroke-width: 2; }
  .robot text {
    fill: var(--hero-icon); stroke: none;
    font: 800 20px system-ui, sans-serif; text-anchor: middle; letter-spacing: 1px;
  }
  .robot .shadow { fill: var(--facet-2); stroke: none; }
  .robot-body { opacity: 0.85; animation: hover 6s ease-in-out infinite; }
  .wave { transform-origin: 180px 162px; animation: wave 4s ease-in-out infinite; }
  .eyes { transform-origin: 130px 82px; animation: blink 5s infinite; }
  .signal { animation: pulse 2.4s ease-in-out infinite; }

  @keyframes hover {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    70% { transform: rotate(-12deg); }
    80% { transform: rotate(6deg); }
    90% { transform: rotate(-8deg); }
  }
  @keyframes blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }
  /* На узких экранах робот прячется, чтобы не закрывать текст. */
  @media (max-width: 900px) {
    .robot { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .robot-body, .wave, .eyes, .signal { animation: none; }
  }
</style>
