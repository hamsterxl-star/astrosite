---
import { siteText } from '../data/site';
import { languages, getLang, localizePath, stripLang, useTranslations, type Lang } from '../i18n/ui';

// Язык текущей страницы и адрес без языкового префикса ('/ru/services' → '/services').
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const current = stripLang(Astro.url.pathname);

// Пункты меню. По адресу текущей страницы подсвечиваем активный пункт.
const links = [
  { path: '/', label: t('nav.home') },
  { path: '/services', label: t('nav.services') },
  { path: '/portfolio', label: t('nav.portfolio') },
  { path: '/contacts', label: t('nav.contacts') },
];
const langs = Object.keys(languages) as Lang[];
---
<header class="header">
  <div class="container header-inner">
    <a href={localizePath(lang, '/')} class="logo">
      <!-- Логотип: public/logo.png, в тёмной теме — светлая версия public/logo-dark.png. -->
      <img class="logo-light" src="/logo.png" alt={siteText[lang].name} width="534" height="160" />
      <img class="logo-dark" src="/logo-dark.png" alt={siteText[lang].name} width="534" height="160" />
    </a>
    <nav>
      {links.map((link) => (
        <a href={localizePath(lang, link.path)} class:list={{ active: current === link.path }}>{link.label}</a>
      ))}
      <span class="langs">
        {langs.map((l) => (
          <a href={localizePath(l, current)} hreflang={l} lang={l} class:list={{ active: l === lang }}>{languages[l]}</a>
        ))}
      </span>
      <button class="theme-toggle" type="button" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
        <span class="icon-moon">🌙</span><span class="icon-sun">☀️</span>
      </button>
    </nav>
  </div>
</header>

<script>
  // Кнопка темы: переключает светлую/тёмную и запоминает выбор в браузере.
  for (const button of document.querySelectorAll('.theme-toggle')) {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme !== 'dark';
      if (dark) root.dataset.theme = 'dark';
      else delete root.dataset.theme;
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
    });
  }
</script>

<style>
  .header { border-bottom: 1px solid var(--border); background: var(--bg); position: sticky; top: 0; z-index: 10; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 16px; }
  .logo { display: block; line-height: 0; }
  .logo img { height: 56px; width: auto; }
  @media (max-width: 600px) { .logo img { height: 40px; } }
  nav { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  nav a { color: var(--muted); text-decoration: none; font-weight: 500; }
  nav a:hover, nav a.active { color: var(--accent); }
  .logo-dark { display: none; }
  :global([data-theme='dark']) .logo-light { display: none; }
  :global([data-theme='dark']) .logo-dark { display: inline; }
  .theme-toggle {
    width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--border);
    background: var(--bg); cursor: pointer; font-size: 16px; line-height: 1; padding: 0;
  }
  .theme-toggle:hover { border-color: var(--accent); }
  .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-sun { display: inline; }
  :global([data-theme='dark']) .icon-moon { display: none; }
  .langs { display: flex; gap: 2px; border: 1px solid var(--border); border-radius: 999px; padding: 2px; }
  .langs a { font-size: 13px; font-weight: 700; padding: 2px 10px; border-radius: 999px; }
  .langs a.active { background: var(--accent); color: var(--bg); }
</style>
