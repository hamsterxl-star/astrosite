---
// Фон первого экрана: мягкие цветные пятна, сетка из точек
// и еле заметные плавающие иконки (сайт, поиск, график, реклама).
// Иконки — простые SVG-рисунки. Чтобы убрать иконку, удалите её строку в списке floaters.

const icons = {
  browser: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><circle cx="6" cy="6.5" r=".6"/><circle cx="8.2" cy="6.5" r=".6"/><path d="M7 13h6M7 16h10"/>',
  search: '<circle cx="11" cy="11" r="6"/><path d="m20 20-4.5-4.5"/>',
  chart: '<path d="M4 20V4M4 20h16"/><path d="m7 15 4-4 3 3 5-6"/><path d="M15 8h4v4"/>',
  cursor: '<path d="m5 3 14 7-6 2-2 6z"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/>',
  megaphone: '<path d="M3 10v4h4l7 4V6l-7 4z"/><path d="M17 9a4 4 0 0 1 0 6"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 6l-3 12"/>',
  click: '<path d="M9 9l11 4-5 2-2 5z"/><path d="M5 5l1.5 1.5M9 3v2M3 9h2"/>',
  globe: '<circle cx="12" cy="12" r="8"/><path d="M4 12h16M12 4c2.5 2.5 2.5 13.5 0 16M12 4c-2.5 2.5-2.5 13.5 0 16"/>',
};

// Где стоит каждая иконка (в % от размеров блока), её размер и скорость.
// Большинство иконок справа, чтобы не мешать тексту слева.
const floaters = [
  { icon: 'browser', top: 10, left: 69, size: 64, dur: 18, delay: 0 },
  { icon: 'search', top: 60, left: 68, size: 44, dur: 14, delay: -4 },
  { icon: 'chart', top: 22, left: 86, size: 56, dur: 20, delay: -8 },
  { icon: 'cursor', top: 70, left: 88, size: 32, dur: 12, delay: -2 },
  { icon: 'target', top: 44, left: 78, size: 40, dur: 16, delay: -10 },
  { icon: 'megaphone', top: 78, left: 56, size: 40, dur: 19, delay: -6 },
  { icon: 'link', top: 6, left: 42, size: 30, dur: 15, delay: -3 },
  { icon: 'code', top: 36, left: 95, size: 34, dur: 17, delay: -12 },
  { icon: 'click', top: 84, left: 26, size: 30, dur: 13, delay: -7 },
  { icon: 'globe', top: 8, left: 4, size: 34, dur: 21, delay: -9 },
] as const;
---
<div class="hero-bg" aria-hidden="true">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>
  <div class="dots"></div>
  {floaters.map((f) => (
    <svg
      class="floater"
      viewBox="0 0 24 24"
      style={`top:${f.top}%;left:${f.left}%;width:${f.size}px;height:${f.size}px;animation-duration:${f.dur}s;animation-delay:${f.delay}s`}
      set:html={icons[f.icon]}
    />
  ))}
</div>

<style>
  /* Фон растянут на всю ширину окна, даже если текст стоит в узкой колонке. */
  .hero-bg {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 100vw;
    transform: translateX(-50%);
    overflow: hidden;
    z-index: -1;
    background: linear-gradient(180deg, var(--hero-top) 0%, var(--bg) 100%);
    /* Нижний край плавно растворяется в фоне страницы. */
    mask-image: linear-gradient(180deg, #000 75%, transparent 100%);
  }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.55; animation: drift 26s ease-in-out infinite alternate; }
  .blob-1 { width: 460px; height: 460px; background: var(--hero-blue); top: -140px; right: 6%; }
  .blob-2 { width: 380px; height: 380px; background: var(--accent-soft); bottom: -160px; right: 32%; animation-delay: -9s; }
  .blob-3 { width: 300px; height: 300px; background: var(--hero-blue); top: 30%; left: -120px; opacity: 0.3; animation-delay: -17s; }
  .dots {
    position: absolute; inset: 0;
    background-image: radial-gradient(var(--hero-dot) 1px, transparent 1px);
    background-size: 26px 26px;
    /* Точки видны справа и плавно исчезают к тексту слева. */
    mask-image: linear-gradient(90deg, transparent 20%, #000 75%);
  }
  .floater {
    position: absolute;
    fill: none; stroke: var(--hero-icon); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round;
    opacity: 0.22;
    animation: float ease-in-out infinite alternate;
  }
  @keyframes float {
    from { transform: translate(0, 0) rotate(-4deg); }
    to { transform: translate(14px, -22px) rotate(5deg); }
  }
  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(-40px, 30px) scale(1.12); }
  }
  /* На телефоне иконок меньше и они бледнее, чтобы не мешать тексту. */
  @media (max-width: 700px) {
    .floater { opacity: 0.13; }
    .floater:nth-of-type(n + 7) { display: none; }
    .dots { mask-image: linear-gradient(180deg, transparent 30%, #000 100%); }
  }
  /* Если посетитель отключил анимации в системе, фон стоит на месте. */
  @media (prefers-reduced-motion: reduce) {
    .floater, .blob { animation: none; }
  }
</style>
