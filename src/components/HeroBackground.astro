---
// Фон первого экрана: светлые геометрические грани, ломаные линии «роста»
// и еле заметные плавающие иконки (сайт, поиск, график, реклама).
// Иконки — простые SVG-рисунки. Чтобы убрать иконку, удалите её строку в списке floaters.

const icons = {
  browser: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><circle cx="6" cy="6.5" r=".6"/><circle cx="8.2" cy="6.5" r=".6"/><path d="M7 13h6M7 16h10"/>',
  search: '<circle cx="11" cy="11" r="6"/><path d="m20 20-4.5-4.5"/>',
  chart: '<path d="M4 20V4M4 20h16"/><path d="m7 15 4-4 3 3 5-6"/><path d="M15 8h4v4"/>',
  cursor: '<path d="m5 3 14 7-6 2-2 6z"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/>',
  megaphone: '<path d="M3 10v4h4l7 4V6l-7 4z"/><path d="M17 9a4 4 0 0 1 0 6"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 6l-3 12"/>',
  click: '<path d="M9 9l11 4-5 2-2 5z"/><path d="M5 5l1.5 1.5M9 3v2M3 9h2"/>',
  globe: '<circle cx="12" cy="12" r="8"/><path d="M4 12h16M12 4c2.5 2.5 2.5 13.5 0 16M12 4c-2.5 2.5-2.5 13.5 0 16"/>',
};

// Где стоит каждая иконка (в % от размеров блока), её размер и скорость.
// Большинство иконок справа, чтобы не мешать тексту слева.
const floaters = [
  { icon: 'browser', top: 10, left: 69, size: 64, dur: 18, delay: 0 },
  { icon: 'search', top: 60, left: 68, size: 44, dur: 14, delay: -4 },
  { icon: 'cursor', top: 70, left: 88, size: 32, dur: 12, delay: -2 },
  { icon: 'target', top: 44, left: 78, size: 40, dur: 16, delay: -10 },
  { icon: 'megaphone', top: 78, left: 56, size: 40, dur: 19, delay: -6 },
  { icon: 'link', top: 6, left: 42, size: 30, dur: 15, delay: -3 },
  { icon: 'code', top: 36, left: 95, size: 34, dur: 17, delay: -12 },
  { icon: 'click', top: 84, left: 26, size: 30, dur: 13, delay: -7 },
  { icon: 'globe', top: 8, left: 4, size: 34, dur: 21, delay: -9 },
] as const;
---
<div class="hero-bg" aria-hidden="true">
  <!-- Правая часть: грани и линии прижаты к правому краю экрана. -->
  <svg class="shapes right" viewBox="560 0 880 520" preserveAspectRatio="xMaxYMax meet">
    <!-- Светлые грани (low-poly) -->
    <polygon class="facet f1" points="900,0 1440,0 1440,180 1130,240" />
    <polygon class="facet f2" points="1130,240 1440,180 1440,520 1240,520" />
    <polygon class="facet f3" points="980,520 1130,240 1240,520" />
    <polygon class="facet f2" points="900,0 1130,240 1010,170" />

    <!-- Ломаная линия роста со стрелкой, как в логотипе -->
    <polyline class="line" points="760,430 880,350 960,390 1070,250 1150,290 1290,120" />
    <path class="line" d="M1250,118 L1294,116 L1282,158" />
    {[[880, 350], [960, 390], [1070, 250], [1150, 290]].map(([x, y]) => (
      <circle class="node" cx={x} cy={y} r="5" />
    ))}

    <!-- Пунктирная ломаная, по ней медленно «бегут» штрихи -->
    <polyline class="dash" points="600,500 720,460 800,480 940,410 1040,440 1200,360 1440,330" />

    <!-- Тонкие изломы-уголки -->
    <polyline class="line thin" points="1330,420 1370,460 1410,420" />
    <polyline class="line thin" points="1330,440 1370,480 1410,440" />
    <polyline class="line thin" points="580,60 610,30 640,60" />
  </svg>
  <!-- Левая часть: пара граней и пунктир у левого края. -->
  <svg class="shapes left" viewBox="0 0 260 520" preserveAspectRatio="xMinYMid meet">
    <polygon class="facet f1" points="0,0 220,0 90,130" />
    <polygon class="facet f3" points="0,380 150,520 0,520" />
    <polyline class="dash thin" points="0,250 70,210 130,240 230,170" />
  </svg>
  {floaters.map((f) => (
    <svg
      class="floater"
      viewBox="0 0 24 24"
      style={`top:${f.top}%;left:${f.left}%;width:${f.size}px;height:${f.size}px;animation-duration:${f.dur}s;animation-delay:${f.delay}s`}
      set:html={icons[f.icon]}
    />
  ))}
</div>

<style>
  /* Фон растянут на всю ширину окна, даже если текст стоит в узкой колонке. */
  .hero-bg {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 100vw;
    transform: translateX(-50%);
    overflow: hidden;
    z-index: -1;
    background: var(--hero-bg);
    border-bottom: 1px solid var(--border);
  }
  .shapes { position: absolute; top: 0; height: 100%; width: auto; }
  .shapes.right { right: 0; }
  .shapes.left { left: 0; }
  .facet.f1 { fill: #edf3ff; }
  .facet.f2 { fill: #e4edff; }
  .facet.f3 { fill: #f2f6ff; }
  .line, .dash { fill: none; stroke: var(--hero-icon); stroke-linecap: round; stroke-linejoin: round; }
  .line { stroke-width: 2; opacity: 0.35; }
  .line.thin { stroke-width: 1.5; opacity: 0.3; }
  .node { fill: var(--hero-bg); stroke: var(--hero-icon); stroke-width: 2; opacity: 0.45; }
  .dash { stroke-width: 1.5; stroke-dasharray: 6 10; opacity: 0.3; animation: dash 30s linear infinite; }
  .floater {
    position: absolute;
    fill: none; stroke: var(--hero-icon); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round;
    opacity: 0.22;
    animation: float ease-in-out infinite alternate;
  }
  @keyframes float {
    from { transform: translate(0, 0) rotate(-4deg); }
    to { transform: translate(14px, -22px) rotate(5deg); }
  }
  @keyframes dash {
    to { stroke-dashoffset: -320; }
  }
  /* На телефоне иконок меньше и они бледнее, чтобы не мешать тексту. */
  @media (max-width: 700px) {
    .floater { opacity: 0.13; }
    .floater:nth-of-type(n + 8) { display: none; }
    .shapes { opacity: 0.4; }
  }
  /* Если посетитель отключил анимации в системе, фон стоит на месте. */
  @media (prefers-reduced-motion: reduce) {
    .floater, .dash { animation: none; }
  }
</style>
