---
// Карточка одной услуги. Данные приходят через props.
const { icon, title, description, price } = Astro.props;
---
<article class="card">
  <div class="icon">{icon}</div>
  <h3>{title}</h3>
  <p>{description}</p>
  {price && <p class="price">{price}</p>}
</article>

<style>
  .icon { font-size: 32px; }
  h3 { margin: 12px 0 8px; }
  p { color: var(--muted); margin: 0; }
  .price { color: var(--accent); font-weight: 700; margin-top: 16px; }
</style>
