---
// Карточка одного проекта из портфолио.
const { title, niche, task, results = [], period, description } = Astro.props;
---
<article class="card">
  <span class="tag">{niche}</span>
  <h3>{title}</h3>
  <p class="task">{task}</p>
  <ul class="results">
    {results.map((r) => <li>{r}</li>)}
  </ul>
  <p class="period">⏱ {period}</p>
  <p class="desc">{description}</p>
</article>

<style>
  .tag { display: inline-block; font-size: 13px; background: var(--accent-soft); color: var(--accent); padding: 2px 10px; border-radius: 999px; }
  h3 { margin: 12px 0 4px; font-size: 22px; }
  .task { color: var(--muted); margin: 0 0 12px; }
  .results { list-style: none; padding: 0; margin: 0 0 12px; }
  .results li { font-weight: 800; color: var(--accent); font-size: 18px; margin-bottom: 4px; }
  .period { font-size: 14px; margin: 0 0 8px; }
  .desc { color: var(--muted); font-size: 15px; margin: 0; }
</style>
