---
// Карточка одного проекта из портфолио.
const { title, niche, result, period, description } = Astro.props;
---
<article class="card">
  <span class="tag">{niche}</span>
  <h3>{title}</h3>
  <p class="result">{result}</p>
  <p class="period">за {period}</p>
  <p>{description}</p>
</article>

<style>
  .tag { display: inline-block; font-size: 13px; background: var(--accent-soft); color: var(--accent); padding: 2px 10px; border-radius: 999px; }
  h3 { margin: 12px 0 4px; }
  .result { font-size: 24px; font-weight: 800; color: var(--accent); margin: 8px 0 0; }
  .period { color: var(--muted); font-size: 14px; margin: 0 0 12px; }
  p { color: var(--muted); }
</style>
