---
// Портфолио на любом языке. Проекты лежат в src/data/portfolio.ts.
import Layout from '../layouts/Layout.astro';
import CaseCard from '../components/CaseCard.astro';
import { cases } from '../data/portfolio';
import { seo } from '../data/seo';
import { getLang, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<Layout title={seo.portfolio[lang].title} description={seo.portfolio[lang].description}>
  <h1>{t('portfolio.title')}</h1>
  <p class="lead">{t('portfolio.lead')}</p>
  <div class="grid list">
    {cases[lang].map((c) => <CaseCard {...c} />)}
  </div>
</Layout>

<style>
  .list { margin-top: 32px; }
</style>
