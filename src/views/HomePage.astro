---
// Главная страница на любом языке. Язык Astro определяет по адресу.
import Layout from '../layouts/Layout.astro';
import PlanCard from '../components/PlanCard.astro';
import CaseCard from '../components/CaseCard.astro';
import { siteText } from '../data/site';
import { plans } from '../data/services';
import { cases } from '../data/portfolio';
import { seo } from '../data/seo';
import { getLang, localizePath, useTranslations, steps } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<Layout title={seo.home[lang].title} description={seo.home[lang].description}>
  <section class="hero">
    <h1>{siteText[lang].tagline}</h1>
    <p class="lead">{siteText[lang].lead}</p>
    <div class="buttons">
      <a class="btn" href={localizePath(lang, '/contacts')}>{t('home.consult')}</a>
      <a class="btn btn-outline" href={localizePath(lang, '/portfolio')}>{t('home.cases')}</a>
    </div>
  </section>

  <h2>{t('home.plans')}</h2>
  <div class="grid plans">
    {plans[lang].map((p) => <PlanCard {...p} />)}
  </div>
  <p><a href={localizePath(lang, '/services')}>{t('home.moreServices')}</a></p>

  <h2>{t('home.howIWork')}</h2>
  <div class="grid steps">
    {steps[lang].map((s, i) => (
      <div class="card">
        <div class="num">{i + 1}</div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))}
  </div>

  <h2>{t('home.projects')}</h2>
  <div class="grid">
    {cases[lang].map((c) => <CaseCard {...c} />)}
  </div>

  <section class="cta card">
    <h2>{t('home.ctaTitle')}</h2>
    <p class="lead">{t('home.ctaText')}</p>
    <a class="btn" href={localizePath(lang, '/contacts')}>{t('home.ctaButton')}</a>
  </section>
</Layout>

<style>
  .hero { padding-block: 32px 16px; }
  .plans { margin-top: 12px; }
  .steps { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .num { width: 40px; height: 40px; border-radius: 50%; background: var(--accent); color: var(--bg); display: grid; place-items: center; font-weight: 800; }
  .steps h3 { margin: 12px 0 4px; }
  .steps p { color: var(--muted); margin: 0; }
  .cta { margin-top: 64px; text-align: center; padding: 40px 24px; }
  .cta h2 { margin-top: 0; }
  .cta .lead { margin: 0 auto 24px; }
</style>
