---
// Главная страница на любом языке. Язык Astro определяет по адресу.
// Порядок блоков: первый экран → SEO простыми словами → результаты клиентов → аудит за 99 € →
// что будет после аудита → калькулятор, тарифы и частые вопросы → призыв написать.
// Тексты блоков лежат в src/data/home.ts.
import Layout from '../layouts/Layout.astro';
import PlanCard from '../components/PlanCard.astro';
import CaseCard from '../components/CaseCard.astro';
import Hero from '../components/Hero.astro';
import AuditForm from '../components/AuditForm.astro';
import SpeedCheck from '../components/SpeedCheck.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import { plans } from '../data/services';
import { cases } from '../data/portfolio';
import { home } from '../data/home';
import { seo } from '../data/seo';
import { getLang, localizePath, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const h = home[lang];
---
<Layout title={seo.home[lang].title} description={seo.home[lang].description}>
  <Hero />

  <!-- 1. SEO простыми словами -->
  <h2>{h.simple.title}</h2>
  <p class="lead">{h.simple.lead}</p>
  <div class="grid simple">
    {h.simple.items.map((item, i) => (
      <div class="card">
        <div class="icon">{item.icon}</div>
        <h3><span class="n">{i + 1}.</span> {item.title}</h3>
        <p>{item.text}</p>
      </div>
    ))}
  </div>
  <p class="ai">🤖 {h.simple.ai}</p>

  <!-- 2. Результаты клиентов -->
  <h2>{h.results.title}</h2>
  <p class="lead">{h.results.lead}</p>
  <div class="grid">
    {cases[lang].map((c) => <CaseCard {...c} />)}
  </div>
  <p><a href={localizePath(lang, '/portfolio')}>{h.results.more}</a></p>

  <!-- 3. Аудит за 99 € с формой -->
  <section class="audit" id="audit">
    <div class="about">
      <h2>{h.audit.title}</h2>
      <p class="lead">{h.audit.lead}</p>
      <ul class="checks">
        {h.audit.checks.map((c) => <li>{c}</li>)}
      </ul>
      <p class="term">⏱ {h.audit.term}</p>
      <p class="credit">{h.audit.credit}</p>
      <SpeedCheck />
    </div>
    <AuditForm />
  </section>

  <!-- 4. Что будет после аудита -->
  <h2>{h.after.title}</h2>
  <p class="lead">{h.after.lead}</p>
  <ol class="timeline">
    {h.after.steps.map((s) => (
      <li>
        <span class="when">{s.when}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
  <p class="note">📊 {h.after.note}</p>

  <!-- 5. Калькулятор, тарифы и частые вопросы -->
  <RoiCalculator />

  <h2>{h.pricing.title}</h2>
  <p class="lead">{h.pricing.lead}</p>
  <div class="grid plans">
    {plans[lang].map((p) => <PlanCard {...p} />)}
  </div>
  <p class="note">{h.pricing.terms} {h.audit.credit}</p>
  <p><a href={localizePath(lang, '/services')}>{h.pricing.more}</a></p>

  <h2>{h.faq.title}</h2>
  <div class="faq">
    {h.faq.items.map((f) => (
      <details class="card">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>

  <section class="cta card">
    <h2>{t('home.ctaTitle')}</h2>
    <p class="lead">{t('home.ctaText')}</p>
    <a class="btn" href={localizePath(lang, '/contacts')}>{t('home.ctaButton')}</a>
  </section>
</Layout>

<style>
  h2 + .lead { margin-top: -12px; margin-bottom: 24px; }

  .simple { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .simple .icon { font-size: 32px; }
  .simple h3 { margin: 8px 0 4px; }
  .simple .n { color: var(--accent); }
  .simple p { color: var(--muted); margin: 0; }
  .ai { margin-top: 20px; padding: 16px 20px; border-radius: 12px; background: var(--accent-soft); font-weight: 600; }

  .audit { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; margin-top: 64px; padding: 32px; border: 2px solid var(--accent); border-radius: 20px; }
  .audit h2 { margin-top: 0; }
  .audit :global(.audit-form) { margin-top: 0; max-width: none; background: var(--bg); }
  .checks { list-style: none; padding: 0; margin: 0 0 16px; }
  .checks li { padding-left: 28px; position: relative; margin-bottom: 8px; }
  .checks li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: 800; }
  .term { margin: 0 0 8px; }
  .credit { margin: 0; padding: 12px 16px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); font-weight: 700; }

  .timeline { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .timeline li { border-top: 3px solid var(--brand-blue); padding-top: 16px; position: relative; }
  .timeline li::before { content: ''; position: absolute; top: -9px; left: 0; width: 15px; height: 15px; border-radius: 50%; background: var(--brand-blue); }
  .when { display: inline-block; font-size: 13px; font-weight: 700; background: var(--accent-soft); color: var(--accent); padding: 2px 10px; border-radius: 999px; }
  .timeline h3 { margin: 10px 0 4px; }
  .timeline p { color: var(--muted); margin: 0; }
  .note { color: var(--muted); margin-top: 20px; }

  .plans { margin-top: 12px; }

  .faq { display: grid; gap: 12px; max-width: 760px; }
  .faq details { padding: 16px 20px; }
  .faq summary { cursor: pointer; font-weight: 700; }
  .faq p { margin: 12px 0 0; color: var(--muted); }

  .cta { margin-top: 64px; text-align: center; padding: 40px 24px; }
  .cta h2 { margin-top: 0; }
  .cta .lead { margin: 0 auto 24px; }

  @media (max-width: 820px) {
    .audit { grid-template-columns: 1fr; padding: 20px; }
    .timeline { grid-template-columns: 1fr; }
  }
</style>
