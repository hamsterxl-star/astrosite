---
// Общий «каркас» для всех страниц: шапка, содержимое и подвал.
// Каждая страница передаёт сюда свой title и description (их тексты лежат в src/data/seo.ts).
// Язык страницы Astro определяет сам по адресу: / испанский, /ru/ русский, /en/ английский.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, getLang, localizePath, stripLang, type Lang } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const { title, description } = Astro.props;

// Ссылки на эту же страницу на других языках — подсказка для Google и Яндекса.
const path = stripLang(Astro.url.pathname);
const langs = Object.keys(languages) as Lang[];
---
<html lang={lang}>
  <head>
    <!-- Тема (светлая/тёмная) применяется до отрисовки страницы, чтобы не было мигания.
         Выбор посетителя запоминается в браузере. По умолчанию — светлая. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {langs.map((l) => <link rel="alternate" hreflang={l} href={localizePath(l, path)} />)}
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* ЕДИНАЯ ПАЛИТРА САЙТА — цвета взяты из логотипа seo2go.
     Правила (см. также CLAUDE.md, раздел «Дизайн»):
     - все кнопки — только классы .btn / .btn-outline / .btn-white (+ .btn-sm для маленьких);
     - заливка кнопок и активных элементов — --brand-blue, текст на ней белый;
     - ссылки, рамки, цены и выделения текста — --accent;
     - новые цвета не добавлять, использовать переменные ниже. */
  :root {
    --brand-blue: #0a73eb;       /* синий из логотипа: кнопки, бейджи, активные элементы */
    --brand-blue-hover: #075fc4; /* синий при наведении */
    --brand-navy: #0f2244;       /* тёмно-синий из логотипа */
    --on-brand: #ffffff;         /* текст на синей заливке */
    --bg: #ffffff;
    --surface: #f4f7fc;
    --text: #0f2244;
    --muted: #4a5872;
    --border: #e1e7f0;
    --accent: #0a73eb;           /* ссылки, рамки, цены */
    --accent-soft: #e7f1fe;      /* мягкий фон для бейджей и наведения */
  }
  /* Тёмная тема: включается кнопкой ☀️/🌙 в шапке. Кнопки остаются того же синего цвета. */
  :root[data-theme='dark'] {
    --bg: #0b1426;
    --surface: #111d33;
    --text: #eef3fb;
    --muted: #9aa8c0;
    --border: #1f2d47;
    --accent: #4c9dff;
    --accent-soft: #12284a;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  body { overflow-x: clip; margin: 0; font-family: system-ui, -apple-system, sans-serif; line-height: 1.6; background: var(--bg); color: var(--text); }
  .container { max-width: 1080px; margin: 0 auto; padding-inline: 16px; }
  h1 { font-size: clamp(32px, 5vw, 52px); line-height: 1.15; margin: 48px 0 16px; }
  h2 { font-size: clamp(24px, 3.5vw, 34px); margin: 64px 0 24px; }
  .lead { font-size: 20px; color: var(--muted); max-width: 640px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; }
  /* Кнопки: одна форма и один цвет на всём сайте */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 12px 24px; border-radius: 12px; border: 2px solid var(--brand-blue);
    background: var(--brand-blue); color: var(--on-brand);
    font: inherit; font-weight: 700; line-height: 1.3; text-decoration: none; cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .btn:hover { background: var(--brand-blue-hover); border-color: var(--brand-blue-hover); color: var(--on-brand); }
  .btn-outline { background: transparent; color: var(--accent); border-color: var(--accent); }
  .btn-outline:hover { background: var(--accent-soft); color: var(--accent); border-color: var(--accent); }
  .btn-white { background: #fff; color: var(--brand-blue); border-color: #fff; }
  .btn-white:hover { background: var(--accent-soft); color: var(--brand-blue); border-color: var(--accent-soft); }
  .btn-sm { padding: 7px 16px; font-size: 15px; border-radius: 10px; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .buttons { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  a { color: var(--accent); }
</style>
