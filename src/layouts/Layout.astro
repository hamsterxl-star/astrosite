---
// Общий «каркас» для всех страниц: шапка, содержимое и подвал.
// Каждая страница передаёт сюда свой заголовок (title) и описание (description).
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const { title, description = site.tagline } = Astro.props;
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | {site.name}</title>
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Цвета сайта. Поменяйте --accent, чтобы сменить фирменный цвет. */
  :root {
    --bg: #ffffff;
    --surface: #f6f5fb;
    --text: #1c1b22;
    --muted: #5d5b6a;
    --border: #e6e4ef;
    --accent: #5b21b6;
    --accent-soft: #ede9fe;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121117;
      --surface: #1c1b24;
      --text: #f1f0f5;
      --muted: #a9a6b8;
      --border: #2c2a36;
      --accent: #a78bfa;
      --accent-soft: #2e2546;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, -apple-system, sans-serif; line-height: 1.6; background: var(--bg); color: var(--text); }
  .container { max-width: 1080px; margin: 0 auto; padding-inline: 16px; }
  h1 { font-size: clamp(32px, 5vw, 52px); line-height: 1.15; margin: 48px 0 16px; }
  h2 { font-size: clamp(24px, 3.5vw, 34px); margin: 64px 0 24px; }
  .lead { font-size: 20px; color: var(--muted); max-width: 640px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; }
  .btn { display: inline-block; background: var(--accent); color: var(--bg); padding: 14px 26px; border-radius: 12px; font-weight: 700; text-decoration: none; }
  .btn-outline { background: transparent; color: var(--accent); border: 2px solid var(--accent); }
  .buttons { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  a { color: var(--accent); }
</style>
